# Copy to .env:  cp .env.example .env
#
# Storage is split by durability:
#   S3 objects  -> MinIO           (persistent, volume minio_data)
#   catalog     -> dynamodb-local  (persistent, volume dynamo_data)
#   SQS queue   -> floci emulator  (ephemeral, host.docker.internal:4566)
# MinIO + dynamodb-local are defined in docker-compose; buckets are created by
# the storage-bootstrap service. Only floci must be started separately.

# --- AWS credentials. Also the MinIO root user/password: the secret must be
# >= 8 chars (MinIO rejects shorter). floci + dynamodb-local ignore creds. ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Object store (MinIO) + catalog (dynamodb-local) are compose services; the SQS
# queue lives in floci on the host, reached via host.docker.internal:4566.
S3_ENDPOINT_URL=http://minio:9000
SQS_ENDPOINT_URL=http://host.docker.internal:4566

# --- Buckets, queues & catalog table (must match infra/terraform outputs) ---
S3_VIDEO_BUCKET=streamsre-raw-uploads
S3_SEGMENTS_BUCKET=streamsre-hls-segments
SQS_TRANSCODE_QUEUE_URL=http://host.docker.internal:4566/000000000000/streamsre-transcode-queue
SQS_DLQ_URL=http://host.docker.internal:4566/000000000000/streamsre-transcode-dlq

# DynamoDB catalog (movie metadata + job status) — persistent dynamodb-local.
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
DYNAMODB_TABLE=streamsre-catalog

# Browser-facing origin URL the worker bakes into stored manifest URLs.
ORIGIN_BASE_URL=http://localhost:8080

# --- Transcode worker ---
FFMPEG_THREADS=0
# Set to 1 to use the GPU (h264_nvenc + CUDA) once nvidia-container-toolkit is
# installed and the deploy.resources GPU block in docker-compose is uncommented.
USE_NVENC=0
TRANSCODE_TIMEOUT_SECONDS=900

# --- Upload API ---
MAX_UPLOAD_SIZE_MB=5000
ALLOWED_EXTENSIONS=mp4,mov,mkv

# --- Admin auth (gates upload + create movie). CHANGE THESE. ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Observability ---
GRAFANA_ADMIN_PASSWORD=admin
TMDB_API_KEY=

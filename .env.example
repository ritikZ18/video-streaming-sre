# Copy to .env:  cp .env.example .env
#
# Every AWS dependency runs locally in docker-compose and is persistent — no
# external emulator is required:
#   S3 objects  -> MinIO           (volume minio_data)
#   catalog     -> dynamodb-local  (volume dynamo_data)
#   job queue   -> dynamodb-local  (durable; replaces the old in-memory SQS)
# Buckets are created by the storage-bootstrap service; the catalog + queue
# tables self-create in-app on first use, so there is no provisioning step.

# --- AWS credentials. Also the MinIO root user/password: the secret must be
# >= 8 chars (MinIO rejects shorter). dynamodb-local ignores creds. ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Object store (MinIO). The catalog + durable queue live in dynamodb-local.
S3_ENDPOINT_URL=http://minio:9000

# --- Buckets + catalog/queue tables ---
S3_VIDEO_BUCKET=streamsre-raw-uploads
S3_SEGMENTS_BUCKET=streamsre-hls-segments

# DynamoDB (persistent dynamodb-local): the movie catalog AND the durable transcode
# queue. The durable queue replaces the old in-memory SQS emulator, so jobs survive
# a restart.
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
DYNAMODB_TABLE=streamsre-catalog
QUEUE_TABLE=streamsre-transcode-queue

# Browser-facing origin URL the worker bakes into stored manifest URLs.
ORIGIN_BASE_URL=http://localhost:8080

# --- Transcode worker ---
FFMPEG_THREADS=0
# Set to 1 to use the GPU (h264_nvenc + CUDA) once nvidia-container-toolkit is
# installed and the deploy.resources GPU block in docker-compose is uncommented.
USE_NVENC=0
TRANSCODE_TIMEOUT_SECONDS=900

# --- Upload API ---
MAX_UPLOAD_SIZE_MB=5000
ALLOWED_EXTENSIONS=mp4,mov,mkv,webm

# --- I/O Framer (RIFE frame interpolation sidecar) ---
# The player's "Smooth" toggle asks the worker to publish a non-destructive
# higher-fps rendition via the io-framer sidecar. The remaining caps (target fps,
# source fps, duration, timeout) use the config defaults; these two are worth setting:
INTERP_ENABLED=1
# Cap interpolation height. The io-framer runs RIFE over Vulkan; on a GPU-Vulkan host
# you can raise this, but on WSL2 there is no NVIDIA Vulkan ICD, so RIFE falls back to
# Mesa lavapipe (CPU) and 4K can't finish inside the timeout. Sources taller than this
# are SKIPPED up front with a clear reason instead of burning the timeout. 1080 is safe.
INTERP_MAX_HEIGHT=1080

# --- Admin auth (gates upload + create movie). CHANGE THESE. ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Observability ---
GRAFANA_ADMIN_PASSWORD=admin
# TMDB API key (server-side only; used by the /api/tmdb proxy for metadata/artwork).
TMDB_API_KEY=

# --- Public viewer (Render static site + Cloudflare tunnel) ---
# Your Render viewer URL. `./start.sh --tunnel` prints the share link as
# ${VIEWER_URL}/?api=<tunnel>, so viewers reach your laptop backend at runtime.
VIEWER_URL=https://your-viewer.onrender.com
